{
  "name": "social",
  "version": "1.0.0",
  "description": "Multiplayer virtual workspace inspired by Gather Town",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "keywords": ["multiplayer", "virtual-workspace", "gather-town", "react", "nodejs", "socketio"],
  "author": "Nevil844",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
} 